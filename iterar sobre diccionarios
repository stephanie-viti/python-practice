def count_letters(text):
  result = {}
  for letter in text:
    if letter not in result:
      result[letter] = 0
    result[letter] += 1
  return result
count_letters("aaaaa")
#output:{'a': 5}
count_letters("tenant")
#output:{'t': 2, 'e': 1, 'n': 2, 'a': 1}
count_letters("a long string with a lot of letters")
#output:{'a': 2, ' ': 7, 'l': 3, 'o': 3, 'n': 2, 'g': 2, 's': 2, 't': 5, 'r': 2, 'i': 2, 'w': 1, 'h': 1, 'f': 1, 'e': 2}
