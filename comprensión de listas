def squares(start, end):
    return [n**2 for n in range(start , end + 1)]


print(squares(2, 3))    # Should print [4, 9]
print(squares(1, 5))    # Should print [1, 4, 9, 16, 25]
print(squares(0, 10))   # Should print [0, 1, 4, 9, 16, 25, 36, 49, 64, 81, 100]
#output:
#[4, 9]
#[1, 4, 9, 16, 25]
